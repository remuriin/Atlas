# Settings for the Rem chat in the Atlas Explorer (docs/build-explorer.js) and for uploading
# the docs to Rem (docs/ingest-docs.js). Copy this file to docs/.env and fill it in.
# Git ignores docs/.env: never commit it.
#
# RAAS_URL: the address of the "Atlas docs" service in the Rem RaaS dashboard,
#   for example https://rag.remservers.me/i/<service id>
# RAAS_KEY: a key of that service. The built page carries this key, so share the page only
#   with people you are happy to let use the chat, and replace the key in the dashboard if
#   it leaks (then build again and run node docs/ingest-docs.js --all).
RAAS_URL=
RAAS_KEY=
