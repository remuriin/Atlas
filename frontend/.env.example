# LearnHub frontend settings. Copy this file to ".env" and fill in the values.
# Everything here ends up in the public website, so it must never hold secrets.
# (Firebase web config values are public identifiers, not passwords.)

# Address of the LearnHub API (no slash at the end).
VITE_API_URL=http://localhost:4000

# true = use the local Firebase Auth emulator (development). false = real Firebase.
VITE_USE_AUTH_EMULATOR=true

# Largest upload allowed. Keep the same as MAX_FILE_SIZE_MB in backend/.env.
VITE_MAX_FILE_SIZE_MB=10

# Firebase web app config (from: firebase apps:sdkconfig WEB <appId>).
# The emulator only needs the project id; "demo-learnhub" is an emulator-only id.
# REPLACE all four with your real project's values before going live.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=demo-learnhub
VITE_FIREBASE_APP_ID=
