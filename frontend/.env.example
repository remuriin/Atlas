# LearnHub frontend settings. Copy this file to ".env" and fill in the values.
# Everything here ends up in the public website, so it must never hold secrets.
# (Firebase web config values are public identifiers, not passwords.)

# Address of the LearnHub API (no slash at the end). This one is the "api" function
# running in the local emulators (start them with "npm run serve" in backend/).
VITE_API_URL=http://127.0.0.1:5001/demo-learnhub/us-central1/api

# true = use the local Firebase emulators (Auth and Storage). false = real Firebase.
VITE_USE_EMULATORS=true

# Largest upload allowed. Keep the same as MAX_FILE_SIZE_MB in the backend settings
# and the limit in storage.rules.
VITE_MAX_FILE_SIZE_MB=10

# Firebase web app config (from: firebase apps:sdkconfig WEB <appId>).
# The emulators only need the project id and bucket; "demo-learnhub" is an emulator-only id.
# Use the real project's values (see .env.production) to work against real Firebase.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=demo-learnhub
VITE_FIREBASE_STORAGE_BUCKET=demo-learnhub.appspot.com
VITE_FIREBASE_APP_ID=
