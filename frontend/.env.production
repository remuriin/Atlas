# Settings used only by "npm run build" (the version that goes on Firebase Hosting).
# They override frontend/.env, which keeps pointing at your local emulators for development.
# Everything here is public, so this file is safe to commit.

# The live API: the "api" Cloud Function.
VITE_API_URL=https://us-central1-learnhub-ea4291.cloudfunctions.net/api

# The live site always uses real Firebase logins and storage.
VITE_USE_EMULATORS=false

# The bucket that holds the uploaded files.
VITE_FIREBASE_STORAGE_BUCKET=learnhub-ea4291.firebasestorage.app
