# Settings used only by "npm run build" (the version that goes on Firebase Hosting).
# They override frontend/.env, which keeps pointing at your local backend for development.
# Everything here is public, so this file is safe to commit.

# The live API on the VPS.
VITE_API_URL=https://api.140-245-60-8.sslip.io

# The live site always uses real Firebase logins.
VITE_USE_AUTH_EMULATOR=false

# The Google sign-in window runs on the site's own address.
VITE_FIREBASE_AUTH_DOMAIN=atlas-f2757.web.app
