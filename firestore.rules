rules_version = '2';

// Browsers never read or write the database directly. Every request goes through
// the API (the "api" Cloud Function), which checks logins, ownership, and input
// before it touches the database. The function's admin access is not affected by
// these rules, so "deny everything" here is the safest setting.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
