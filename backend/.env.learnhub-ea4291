# Settings for the LIVE function (project learnhub-ea4291).
# Firebase reads this file when deploying. Nothing secret belongs here: the Gemini
# key is kept in Secret Manager (firebase functions:secrets:set GEMINI_API_KEY).
# Never add any *_EMULATOR_HOST line here: the API refuses to start if one is set.

# The exact address of the website. Only this origin may call the API from a browser.
FRONTEND_ORIGIN=https://learnhub-ea4291.web.app

# The bucket that holds the uploaded files.
STORAGE_BUCKET=learnhub-ea4291.firebasestorage.app

# The largest allowed upload. Keep the same as in storage.rules and frontend/.env.
MAX_FILE_SIZE_MB=10

# Google's servers pass the visitor's real address on, so rate limiting can count visitors.
TRUST_PROXY=true

# The Gemini model that writes the flashcards.
GEMINI_MODEL=gemini-3.5-flash-lite
