# Atlas backend settings.
# Copy this file to ".env" and fill in the values. Never commit ".env".

# Port the API listens on.
PORT=4000

# >>> REPLACE WITH YOUR VPS POSTGRES URL <<<
# Format: postgres://USER:PASSWORD@HOST:5432/DBNAME
# If the backend runs on the same VPS as Postgres, HOST should be localhost.
# The server refuses to start while this is still the placeholder below.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# Set to true only when Postgres is on another machine and requires SSL.
DATABASE_SSL=false

# Firebase project id (used to check that login tokens belong to this app).
# "demo-atlas" only works with the local Auth emulator.
# REPLACE WITH YOUR REAL FIREBASE PROJECT ID before going live
# (the same value as VITE_FIREBASE_PROJECT_ID in frontend/.env).
FIREBASE_PROJECT_ID=demo-atlas

# DEVELOPMENT ONLY: makes the backend accept tokens from the local Auth emulator.
# DELETE this line (or leave it empty) on your real server.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# The exact address of the frontend. Only this origin may call the API.
FRONTEND_ORIGIN=http://localhost:5173

# Where uploaded files are stored on disk, and the largest allowed upload.
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Set to true when the API runs behind nginx, so rate limiting sees real visitor IPs.
TRUST_PROXY=false

# Google Gemini API key, used ONLY by the server to turn saved study reviewers into
# flashcards. Get one at https://aistudio.google.com/apikey. This is a secret:
# never put it in frontend/.env and never commit it. Leave it empty to turn
# flashcards off (everything else keeps working).
GEMINI_API_KEY=

# The Gemini model that writes the flashcards.
GEMINI_MODEL=gemini-3.5-flash-lite

# Virus scan for uploads with ClamAV. off = no scan (development only).
# daemon  = the ClamAV service (clamav-daemon): fast, keeps about 1-1.5 GB of RAM in use.
# command = run clamscan once per upload: low RAM, but 10-30 seconds per upload.
# When a scan cannot run, the upload is refused rather than let through unscanned.
CLAMAV_MODE=off
# Only for daemon mode: the service's socket (this is the Ubuntu/Debian default).
CLAMAV_SOCKET=/var/run/clamav/clamd.ctl
