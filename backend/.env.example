# LearnHub backend settings for LOCAL development with the Firebase emulators.
# Copy this file to "backend/.env.local" (NOT ".env": Firebase would upload a plain
# .env file to the live function). .env.local is only read by the emulators.
#
# The live settings are in backend/.env.learnhub-ea4291 instead.
# The emulators set their own addresses (FIREBASE_AUTH_EMULATOR_HOST and friends),
# so they do not need to be written here.

# The exact address of the frontend. Only this origin may call the API.
FRONTEND_ORIGIN=http://localhost:5173

# The largest allowed upload. Keep the same as in storage.rules and frontend/.env.
MAX_FILE_SIZE_MB=10

# The Gemini model that writes the flashcards.
GEMINI_MODEL=gemini-3.5-flash-lite

# The Gemini key is NOT set here. For local flashcards, put this one line in
# "backend/.secret.local" (never commit it, never share it):
#   GEMINI_API_KEY=your-key
# Without it the app still runs; only "Make flashcards" says it is not set up yet.
